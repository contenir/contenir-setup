{
    "name": "contenir/contenir-setup",
    "description": "Installation and setup module for Contenir CMS - handles initial configuration and database setup",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "mezzio",
        "cms",
        "installer",
        "setup"
    ],
    "authors": [
        {
            "name": "Contenir",
            "email": "hello@contenir.com"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-db": "^2.20",
        "laminas/laminas-diactoros": "^3.3",
        "laminas/laminas-servicemanager": "^3.22",
        "laminas/laminas-view": "^2.33",
        "mezzio/mezzio": "^3.18",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2"
    },
    "require-dev": {
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Setup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Setup\\Tests\\": "tests/"
        },
        "classmap": [
            "stubs/"
        ]
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        },
        "laminas": {
            "config-provider": "Contenir\\Setup\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
